index 0000000..3146d32
--- /dev/null
+++ b/research/lean-multi-host-source/SourceInvocation.lean
@@ -0,0 +1,195 @@
+import SourceInvocationComparison
+import SourceInitialPayload
+import SourceNativeInvocation
+import SelectedGeometry
+import SourceMoveGeometry
+import SourceDataBehavior
+
+/-!
+The selected PR442 stage2/replica0 invocation, connected to MultiHosting.
+
+The maps below are the literal source data routes, the 747 constructed host
+owners/charts, the original parent-bank owners/charts, and all 19,002 source
+events. No geometry, ownership, clean-work or input-matching premise is
+assumed. Every retained host, all 240 data streams, the exterior of both
+active owner images, and all 747 old-bank inputs are arbitrary Boolean
+functions on paired 64-dimensional addresses.
+
+This is one local invocation. The displayed completion applies the remaining
+pending swaps immediately in the abstract window. It does not prove their
+later positions in the real recursive schedule, a whole-cover sweep, a global
+bank renumbering, a register-cost saving, or a new kappa bound.
+-/
+namespace SourceInvocation
+open SourceConnection FramedReplay
+variable (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+variable (d : SourceOwnership.Vec K ≃ SourceOwnership.Vec K)
+set_option maxRecDepth 100000
+set_option maxHeartbeats 0
+attribute [local irreducible] SourceRaw.final SourceFramed.final
+
+/-- A concrete physical contract for the actual old and relocated raw
+instruction folds. Even the original-bank outputs are the actual outputs
+of that fold; they have not been replaced with their initial values. -/
+noncomputable def actualContract :
+    MultiHosting.PhysicalContract (K := K) (A := Bool)
+      (PhysicalSourceConnection.event (Tail := Tail K h2 d)
+        (SelectedGeometry.gauges K h2) (dataInput K h2) (dataOutput K h2))
+      (Host → Streams K) Unit where
+  original := oldResult K h2 d (SelectedGeometry.gauges K h2)
+  relocated := newResult K h2 d (SelectedGeometry.gauges K h2)
+  original_retained s bank :=
+    (congrArg Prod.fst (oldResult_framed K h2 d (SelectedGeometry.gauges K h2) s bank)).trans
+      (PhysicalSourceConnection.original_retained _ _ _ _ _ s bank)
+  relocated_retained s bank :=
+    (congrArg Prod.fst (newResult_framed K h2 d (SelectedGeometry.gauges K h2) s bank)).trans
+      (PhysicalSourceConnection.relocated_retained _ (SelectedGeometry.helper_relative K h2)
+        _ _ s bank)
+
+/-- All retained outputs of this actual invocation satisfy the multi-host
+completion equation, for arbitrary dirty input. The only algebraic condition
+is characteristic different from two; d is any invertible cover map.
+Child-1 pending coordinates are 15..21 and child-2 coordinates are 1..28. -/
+theorem selected_call_completion (s : State K h2 d) (oldBank : Host → Streams K) :
+    MultiHosting.onHosts
+      (MultiHosting.remainders PhysicalSourceConnection.pending
+        [PhysicalSourceConnection.event (Tail := Tail K h2 d) (SelectedGeometry.gauges K h2)
+          (dataInput K h2) (dataOutput K h2)])
+      (newResult K h2 d (SelectedGeometry.gauges K h2) (s, ())).1 =
+    MultiHosting.onHosts PhysicalSourceConnection.pending
+      (oldResult K h2 d (SelectedGeometry.gauges K h2) (s, oldBank)).1 := by
+  have hn := congrArg
+    (fun out : State K h2 d × Unit =>
+      MultiHosting.onHosts
+        (MultiHosting.remainders PhysicalSourceConnection.pending
+          [PhysicalSourceConnection.event (Tail := Tail K h2 d) (SelectedGeometry.gauges K h2)
+            (dataInput K h2) (dataOutput K h2)]) out.1)
+    (newResult_framed K h2 d (SelectedGeometry.gauges K h2) s ())
+  have ho := congrArg
+    (fun out : State K h2 d × (Host → Streams K) =>
+      MultiHosting.onHosts PhysicalSourceConnection.pending out.1)
+    (oldResult_framed K h2 d (SelectedGeometry.gauges K h2) s oldBank)
+  exact hn.trans ((PhysicalSourceConnection.selected_invocation_completion
+    (SelectedGeometry.gauges K h2) (SelectedGeometry.helper_relative K h2)
+    (dataInput K h2) (dataOutput K h2) (oldInput K h2) (oldOutput K h2)
+    s oldBank ()).trans ho.symm)
+
+/-- The same completion equation for the native source folds themselves,
+read in the common retained coordinate charts. The preceding input identity
+lemmas guarantee that these runs start with the same retained native data. -/
+theorem selected_native_completion (s : State K h2 d) (oldBank : Host → Streams K) :
+    MultiHosting.onHosts
+      (MultiHosting.remainders PhysicalSourceConnection.pending
+        [PhysicalSourceConnection.event (Tail := Tail K h2 d) (SelectedGeometry.gauges K h2)
+          (dataInput K h2) (dataOutput K h2)])
+      (newNativeResult K h2 d (SelectedGeometry.gauges K h2) (s, ())).1 =
+    MultiHosting.onHosts PhysicalSourceConnection.pending
+      (oldNativeResult K h2 d (SelectedGeometry.gauges K h2) (s, oldBank)).1 := by
+  have hn := congrArg
+    (fun out : State K h2 d × Unit =>
+      MultiHosting.onHosts
+        (MultiHosting.remainders PhysicalSourceConnection.pending
+          [PhysicalSourceConnection.event (Tail := Tail K h2 d) (SelectedGeometry.gauges K h2)
+            (dataInput K h2) (dataOutput K h2)]) out.1)
+    (newResult_native K h2 d (SelectedGeometry.gauges K h2) s ())
+  have ho := congrArg
+    (fun out : State K h2 d × (Host → Streams K) =>
+      MultiHosting.onHosts PhysicalSourceConnection.pending out.1)
+    (oldResult_native K h2 d (SelectedGeometry.gauges K h2) s oldBank)
+  exact hn.symm.trans ((selected_call_completion K h2 d s oldBank).trans ho)
+
+/-- Concrete data behavior, including each port's actual initial/final
+frame and its literal rho chart. The target term is XOR source; the displayed
+coordinate pullbacks are retained rather than silently made identities. -/
+theorem selected_data_formula (s : State K h2 d) (oldBank : Host → Streams K) (i : Data) :
+    (oldRaw K h2 d (SelectedGeometry.gauges K h2) s oldBank
+      (oldOwner K h2 d (SourceLayouts.dataRole i))).2 =
+      SourceDataBehavior.dataFormula K h2 (SelectedGeometry.gauges K h2) s.2.1 i ∧
+    (newRaw K h2 d (SelectedGeometry.gauges K h2) s
+      (newOwner K h2 d (SourceLayouts.dataRole i))).2 =
+      SourceDataBehavior.dataFormula K h2 (SelectedGeometry.gauges K h2) s.2.1 i :=
+  ⟨SourceDataBehavior.old_data_formula K h2 d _ s oldBank i,
+    SourceDataBehavior.new_data_formula K h2 d _ s i⟩
+
+/-- These are two coordinate descriptions of the very same native source
+fold, with all initial payloads constructed explicitly. Thus the contract
+above does not posit an extra routed interface for the physical XOR gates. -/
+theorem selected_native_realization (s : State K h2 d) (oldBank : Host → Streams K) :
+    oldRaw K h2 d (SelectedGeometry.gauges K h2) s oldBank =
+      OwnerTransport.fromNative (commonNativeCover K h2 d)
+        (oldNative K h2 d (SelectedGeometry.gauges K h2) s oldBank) ∧
+    newRaw K h2 d (SelectedGeometry.gauges K h2) s =
+      OwnerTransport.fromNative (commonNativeCover K h2 d)
+        (newNative K h2 d (SelectedGeometry.gauges K h2) s) :=
+  ⟨old_native_realization K h2 d _ s oldBank, new_native_realization K h2 d _ s⟩
+
+/-- COPY blankness and ERASE equality follow the actual native trajectories;
+there is no clean assumption on any of the 987 original streams. -/
+theorem selected_native_clean (s : State K h2 d) (oldBank : Host → Streams K) :
+    SourceRawGuards.NativeCleanRun (oldOwner K h2 d) (nativeGauge K d)
+      (SourceFrameTrace.forward.map (SourceFrameTrace.toRoute (SelectedGeometry.gauges K h2)))
+      (SourceRaw.initial (oldOwner K h2 d) (SelectedGeometry.gauges K h2)
+        (nativePayload K (commonNativeCover K h2 d) (oldPayload K h2 d s oldBank))) ∧
+    SourceRawGuards.NativeCleanRun (newOwner K h2 d) (nativeGauge K d)
+      (SourceFrameTrace.forward.map (SourceFrameTrace.toRoute (SelectedGeometry.gauges K h2)))
+      (SourceRaw.initial (newOwner K h2 d) (SelectedGeometry.gauges K h2)
+        (nativePayload K (commonNativeCover K h2 d) (newPayload K h2 d s))) :=
+  ⟨old_native_clean K h2 d _ s oldBank, new_native_clean K h2 d _ s⟩
+
+/-- The complete actual relocated raw invocation also realizes the literal
+matrix operators: every MOVE is D_(Pnew-Pold), and COPY uses the full local
+8-coordinate transport. This equality includes frame metadata and payloads. -/
+theorem selected_matrix_realization (s : State K h2 d) :
+    (fun r => OwnerTransport.gather (newOwner K h2 d) (newChart K h2)
+      (newRaw K h2 d (SelectedGeometry.gauges K h2) s) r) =
+    fun r => (SourceMoveGeometry.matrixRun K h2 SourceFrameTrace.forward
+      (SourceFramed.initial (SelectedGeometry.gauges K h2)
+        (packed (fun i => dataInput K h2 i (s.2.1 i))
+          (fun h => hostInput h (s.1 h))))).get r.val := by
+  have hg := funext (InvocationPayload.realized_gather (newOwner K h2 d) (newChart K h2)
+    (fun h => newOwner_injective K h2 d h) (SelectedGeometry.gauges K h2)
+    (fun i => dataInput K h2 i (s.2.1 i)) (fun h => hostInput h (s.1 h))
+    (tailPayload K h2 d s))
+  exact hg.trans (congrArg
+    (fun store : FramedReplay.Store (WholeHosting.Address SourceOwnership.Axis K) =>
+      fun r : SourceRaw.Role => store.get r.val)
+    (SourceMoveGeometry.actual_matrix_run K h2 _).symm)
+
+/-- The original-bank invocation uses the same certified matrix word. -/
+theorem selected_original_matrix_realization (s : State K h2 d)
+    (bank : Host → Streams K) :
+    (fun r => OwnerTransport.gather (oldOwner K h2 d) (oldChart K h2)
+      (oldRaw K h2 d (SelectedGeometry.gauges K h2) s bank) r) =
+    fun r => (SourceMoveGeometry.matrixRun K h2 SourceFrameTrace.forward
+      (SourceFramed.initial (SelectedGeometry.gauges K h2)
+        (packed (fun i => dataInput K h2 i (s.2.1 i))
+          (fun h => oldInput K h2 h (bank h))))).get r.val := by
+  have hg := funext (InvocationPayload.realized_gather (oldOwner K h2 d) (oldChart K h2)
+    (fun h => oldOwner_injective K h2 d h) (SelectedGeometry.gauges K h2)
+    (fun i => dataInput K h2 i (s.2.1 i)) (fun h => oldInput K h2 h (bank h))
+    (hostPayload K h2 d s))
+  exact hg.trans (congrArg
+    (fun store : FramedReplay.Store (WholeHosting.Address SourceOwnership.Axis K) =>
+      fun r : SourceRaw.Role => store.get r.val)
+    (SourceMoveGeometry.actual_matrix_run K h2 _).symm)
+
+/-- Both physical private temporaries are returned blank. -/
+theorem selected_temporary_restoration (s : State K h2 d) (oldBank : Host → Streams K) :
+    (oldNative K h2 d (SelectedGeometry.gauges K h2) s oldBank
+      (oldOwner K h2 d SourceRaw.privateRow)).2 = (fun _ => false) ∧
+    (newNative K h2 d (SelectedGeometry.gauges K h2) s
+      (newOwner K h2 d SourceRaw.privateRow)).2 = (fun _ => false) :=
+  ⟨old_native_temporary_restored K h2 d _ s oldBank,
+    new_native_temporary_restored K h2 d _ s⟩
+
+end SourceInvocation
+
+#print axioms SourceInvocation.selected_call_completion
+#print axioms SourceInvocation.selected_native_realization
+#print axioms SourceInvocation.selected_native_clean
+#print axioms SourceInvocation.selected_matrix_realization
+#print axioms SourceInvocation.selected_original_matrix_realization
+#print axioms SourceInvocation.selected_temporary_restoration
+
+#print axioms SourceInvocation.selected_native_completion
+#print axioms SourceInvocation.selected_data_formula
diff --git a/research/lean-multi-host-source/SourceInvocationComparison.lean b/research/lean-multi-host-source/SourceInvocationComparison.lean
new file mode 100644
index 0000000..d344644
--- /dev/null
+++ b/research/lean-multi-host-source/SourceInvocationComparison.lean
@@ -0,0 +1,138 @@
+import SourceInvocationState
+import PhysicalSourceConnection
+
+/-! Comparison of actual raw outputs with the framed hosting contract.
+All maps and owner layouts are concrete. These lemmas expose every output
+class, including the original bank, instead of discarding affected rows. -/
+namespace SourceInvocation
+open SourceConnection FramedReplay
+variable (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+variable (d : SourceOwnership.Vec K ≃ SourceOwnership.Vec K)
+set_option maxRecDepth 100000
+set_option maxHeartbeats 0
+attribute [local irreducible] SourceRaw.final SourceFramed.final
+
+theorem oldRaw_data (gauges : Gauges K) (s : State K h2 d)
+    (bank : Host → Streams K) (i : Data) :
+    (oldRaw K h2 d gauges s bank (oldOwner K h2 d (SourceLayouts.dataRole i))).2 =
+      dataOutput K h2 i
+        (PhysicalSourceConnection.physicalData gauges
+          (fun j => dataInput K h2 j (s.2.1 j))
+          (fun h => oldInput K h2 h (bank h)) i) := by
+  funext a
+  have he := InvocationPayload.realized_payload (oldOwner K h2 d) (oldChart K h2)
+    (fun h => oldOwner_injective K h2 d h) gauges
+    (fun j => dataInput K h2 j (s.2.1 j))
+    (fun h => oldInput K h2 h (bank h)) (hostPayload K h2 d s)
+    (SourceLayouts.dataRole i) a
+  have hc : oldChart K h2 (SourceLayouts.dataRole i) =
+      newChart K h2 (SourceLayouts.dataRole i) := SourceLayouts.data_chart_eq K h2 i
+  rw [hc] at he
+  exact he
+
+theorem newRaw_data (gauges : Gauges K) (s : State K h2 d) (i : Data) :
+    (newRaw K h2 d gauges s (newOwner K h2 d (SourceLayouts.dataRole i))).2 =
+      dataOutput K h2 i
+        (PhysicalSourceConnection.physicalData gauges
+          (fun j => dataInput K h2 j (s.2.1 j))
+          (fun h => hostInput h (s.1 h)) i) := by
+  funext a
+  exact InvocationPayload.realized_payload (newOwner K h2 d) (newChart K h2)
+    (fun h => newOwner_injective K h2 d h) gauges
+    (fun j => dataInput K h2 j (s.2.1 j))
+    (fun h => hostInput h (s.1 h)) (tailPayload K h2 d s)
+    (SourceLayouts.dataRole i) a
+
+theorem oldRaw_bank (gauges : Gauges K) (s : State K h2 d)
+    (bank : Host → Streams K) (h : Host) :
+    (oldRaw K h2 d gauges s bank (oldOwner K h2 d (SourceLayouts.hostRole h))).2 =
+      oldOutput K h2 h
+        (PhysicalSourceConnection.physicalHelpers gauges
+          (fun j => dataInput K h2 j (s.2.1 j))
+          (fun j => oldInput K h2 j (bank j)) h) := by
+  funext a
+  exact InvocationPayload.realized_payload (oldOwner K h2 d) (oldChart K h2)
+    (fun he => oldOwner_injective K h2 d he) gauges
+    (fun j => dataInput K h2 j (s.2.1 j))
+    (fun j => oldInput K h2 j (bank j)) (hostPayload K h2 d s)
+    (SourceLayouts.hostRole h) a
+
+theorem oldRaw_host (gauges : Gauges K) (s : State K h2 d)
+    (bank : Host → Streams K) (h : Host) :
+    (oldRaw K h2 d gauges s bank (hostOwner K h2 d h)).2 =
+      fun a => s.1 h ((hostChart K h2 h).inverse a) := by
+  exact (SourceRaw.other_payload_preserved (oldOwner K h2 d) (oldChart K h2)
+    gauges (oldPayload K h2 d s bank) (hostOwner K h2 d h)
+    (host_not_old K h2 d h)).trans (oldPayload_host K h2 d s bank h)
+
+theorem newRaw_host (gauges : Gauges K) (s : State K h2 d) (h : Host)
+    (a : WholeHosting.Address SourceOwnership.Axis K) :
+    (newRaw K h2 d gauges s (hostOwner K h2 d h)).2 ((hostChart K h2 h).forward a) =
+      PhysicalSourceConnection.scatterHost h
+        (PhysicalSourceConnection.physicalHelpers gauges
+          (fun j => dataInput K h2 j (s.2.1 j))
+          (fun j => hostInput j (s.1 j)) h) a := by
+  have he := InvocationPayload.realized_payload (newOwner K h2 d) (newChart K h2)
+    (fun he => newOwner_injective K h2 d he) gauges
+    (fun j => dataInput K h2 j (s.2.1 j))
+    (fun j => hostInput j (s.1 j)) (tailPayload K h2 d s)
+    (SourceLayouts.hostRole h) ((hostChart K h2 h).forward a)
+  have hc : (newChart K h2 (SourceLayouts.hostRole h)).inverse
+      ((hostChart K h2 h).forward a) =
+      SourceOwnership.unindex (SourceOwnership.tag (role h)) a := by
+    exact (SourceLayouts.host_chart_inverse K h2 h _).trans
+      (congrArg (SourceOwnership.unindex (SourceOwnership.tag (role h)))
+        ((hostChart K h2 h).inverse_forward a))
+  rw [hc] at he
+  exact he
+
+theorem oldRaw_outside (gauges : Gauges K) (s : State K h2 d)
+    (bank : Host → Streams K) (t : TailKey K h2 d) :
+    (oldRaw K h2 d gauges s bank t.val).2 = s.2.2 t :=
+  (SourceRaw.other_payload_preserved (oldOwner K h2 d) (oldChart K h2)
+    gauges (oldPayload K h2 d s bank) t.val t.property.1).trans
+    (oldPayload_outside K h2 d s bank t)
+
+theorem newRaw_outside (gauges : Gauges K) (s : State K h2 d)
+    (t : TailKey K h2 d) : (newRaw K h2 d gauges s t.val).2 = s.2.2 t :=
+  (SourceRaw.other_payload_preserved (newOwner K h2 d) (newChart K h2)
+    gauges (newPayload K h2 d s) t.val t.property.2).trans
+    (newPayload_outside K h2 d s t)
+
+/-- Equality includes the actual old-bank outputs as well as all retained
+rows. No dirty-bank output is silently removed from this correspondence. -/
+theorem oldResult_framed (gauges : Gauges K) (s : State K h2 d)
+    (bank : Host → Streams K) :
+    oldResult K h2 d gauges (s, bank) =
+      PhysicalSourceConnection.original gauges (dataInput K h2) (dataOutput K h2)
+        (oldInput K h2) (oldOutput K h2) (s, bank) := by
+  apply Prod.ext
+  · apply Prod.ext
+    · funext h a
+      exact (congrFun (oldRaw_host K h2 d gauges s bank h)
+        ((hostChart K h2 h).forward a)).trans
+        (congrArg (s.1 h) ((hostChart K h2 h).inverse_forward a))
+    · apply Prod.ext
+      · funext i
+        exact oldRaw_data K h2 d gauges s bank i
+      · funext t
+        exact oldRaw_outside K h2 d gauges s bank t
+  · funext h
+    exact oldRaw_bank K h2 d gauges s bank h
+
+theorem newResult_framed (gauges : Gauges K) (s : State K h2 d) (bank : Unit) :
+    newResult K h2 d gauges (s, bank) =
+      PhysicalSourceConnection.relocated gauges (dataInput K h2) (dataOutput K h2)
+        (s, bank) := by
+  apply Prod.ext
+  · apply Prod.ext
+    · funext h a
+      exact newRaw_host K h2 d gauges s h a
+    · apply Prod.ext
+      · funext i
+        exact newRaw_data K h2 d gauges s i
+      · funext t
+        exact newRaw_outside K h2 d gauges s t
+  · rfl
+
+end SourceInvocation
diff --git a/research/lean-multi-host-source/SourceInvocationState.lean b/research/lean-multi-host-source/SourceInvocationState.lean
new file mode 100644
index 0000000..2d1d988
--- /dev/null
+++ b/research/lean-multi-host-source/SourceInvocationState.lean
@@ -0,0 +1,135 @@
+import SourceLayouts
+import InvocationPayload
+
+/-! Concrete raw input and output layouts for the single selected call.
+Both embeddings expose every retained host, all data and the entire exterior
+of the union of the two active owner images. The old bank is an arbitrary
+separate input and an actual returned output. This common universe is a
+local comparison device, not a global allocation or bank-renumbering claim. -/
+namespace SourceInvocation
+open SourceConnection FramedReplay
+
+abbrev Slot (K : Type) := Nat × (SourceOwnership.Vec K → SourceOwnership.Vec K)
+abbrev RawPayload (K : Type) := Slot K → Streams K
+abbrev Gauges (K : Type) := Nat → Gauge (WholeHosting.Address SourceOwnership.Axis K)
+
+variable (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+variable (d : SourceOwnership.Vec K ≃ SourceOwnership.Vec K)
+
+def oldOwner := ParentOwnership.sourceActiveOwner K h2 d
+def newOwner := SourceOwnership.sourceActiveOwner K h2 d
+def oldChart := ParentOwnership.sourceActiveAddressChart K h2
+def newChart := SourceOwnership.sourceActiveAddressChart K h2
+
+def hostOwner (h : Host) : Slot K := newOwner K h2 d (SourceLayouts.hostRole h)
+def hostChart (h : Host) := SourceOwnership.familyAddressChart K h2
+  (SourceOwnership.family (role h))
+
+def Outside (p : Slot K) : Prop :=
+  (∀ r, p ≠ oldOwner K h2 d r) ∧ (∀ r, p ≠ newOwner K h2 d r)
+abbrev TailKey := {p : Slot K // Outside K h2 d p}
+abbrev Tail := TailKey K h2 d → Streams K
+abbrev State := MultiHosting.WindowState Host SourceOwnership.Axis K Bool
+  (Retained K (Tail K h2 d))
+
+noncomputable def tailPayload (s : State K h2 d) : RawPayload K := by
+  classical
+  exact fun p => if hp : Outside K h2 d p then s.2.2 ⟨p, hp⟩ else fun _ => false
+
+noncomputable def hostPayload (s : State K h2 d) : RawPayload K :=
+  InvocationPayload.extend (hostOwner K h2 d)
+    (fun h a => s.1 h ((hostChart K h2 h).inverse a)) (tailPayload K h2 d s)
+
+def dataInput (i : Data) (v : Streams K) : Streams K :=
+  fun a => v ((newChart K h2 (SourceLayouts.dataRole i)).forward a)
+def dataOutput (i : Data) (v : Streams K) : Streams K :=
+  fun a => v ((newChart K h2 (SourceLayouts.dataRole i)).inverse a)
+def oldInput (h : Host) (v : Streams K) : Streams K :=
+  fun a => v ((oldChart K h2 (SourceLayouts.hostRole h)).forward a)
+def oldOutput (h : Host) (v : Streams K) : Streams K :=
+  fun a => v ((oldChart K h2 (SourceLayouts.hostRole h)).inverse a)
+
+noncomputable def oldPayload (s : State K h2 d) (bank : Host → Streams K) : RawPayload K :=
+  InvocationPayload.realize (oldOwner K h2 d) (oldChart K h2)
+    (packed (fun i => dataInput K h2 i (s.2.1 i))
+      (fun h => oldInput K h2 h (bank h))) (hostPayload K h2 d s)
+
+noncomputable def newPayload (s : State K h2 d) : RawPayload K :=
+  InvocationPayload.realize (newOwner K h2 d) (newChart K h2)
+    (packed (fun i => dataInput K h2 i (s.2.1 i))
+      (fun h => hostInput h (s.1 h))) (tailPayload K h2 d s)
+
+noncomputable def oldRaw (gauges : Gauges K) (s : State K h2 d) (bank : Host → Streams K) :=
+  SourceRaw.final (oldOwner K h2 d) (oldChart K h2) gauges (oldPayload K h2 d s bank)
+noncomputable def newRaw (gauges : Gauges K) (s : State K h2 d) :=
+  SourceRaw.final (newOwner K h2 d) (newChart K h2) gauges (newPayload K h2 d s)
+
+noncomputable def oldResult (gauges : Gauges K)
+    (sb : State K h2 d × (Host → Streams K)) : State K h2 d × (Host → Streams K) :=
+  let raw := oldRaw K h2 d gauges sb.1 sb.2
+  ((fun h a => (raw (hostOwner K h2 d h)).2 ((hostChart K h2 h).forward a),
+    (fun i => (raw (oldOwner K h2 d (SourceLayouts.dataRole i))).2,
+      fun t => (raw t.val).2)),
+    fun h => (raw (oldOwner K h2 d (SourceLayouts.hostRole h))).2)
+
+noncomputable def newResult (gauges : Gauges K)
+    (sb : State K h2 d × Unit) : State K h2 d × Unit :=
+  let raw := newRaw K h2 d gauges sb.1
+  ((fun h a => (raw (hostOwner K h2 d h)).2 ((hostChart K h2 h).forward a),
+    (fun i => (raw (newOwner K h2 d (SourceLayouts.dataRole i))).2,
+      fun t => (raw t.val).2)), sb.2)
+
+theorem oldOwner_injective : Function.Injective (oldOwner K h2 d) :=
+  ParentOwnership.sourceActiveOwner_injective K h2 d
+theorem newOwner_injective : Function.Injective (newOwner K h2 d) :=
+  SourceOwnership.sourceActiveOwner_injective K h2 d
+
+theorem hostOwner_injective : Function.Injective (hostOwner K h2 d) := by
+  intro r s h
+  have he := newOwner_injective K h2 d h
+  apply Fin.ext
+  have hv := congrArg Fin.val he
+  change 240 + r.val = 240 + s.val at hv
+  omega
+
+theorem host_not_old (h : Host) (r : SourceRaw.Role) :
+    hostOwner K h2 d h ≠ oldOwner K h2 d r := by
+  exact fun he => SourceLayouts.parent_owner_ne_host K h2 d r h he.symm
+
+theorem tailPayload_outside (s : State K h2 d) (t : TailKey K h2 d) :
+    tailPayload K h2 d s t.val = s.2.2 t := by
+  classical
+  simp only [tailPayload, dif_pos t.property]
+
+theorem hostPayload_host (s : State K h2 d) (h : Host) :
+    hostPayload K h2 d s (hostOwner K h2 d h) =
+      fun a => s.1 h ((hostChart K h2 h).inverse a) :=
+  InvocationPayload.extend_owner _ (fun he => hostOwner_injective K h2 d he) _ _ h
+
+theorem hostPayload_outside (s : State K h2 d) (t : TailKey K h2 d) :
+    hostPayload K h2 d s t.val = s.2.2 t := by
+  rw [hostPayload, InvocationPayload.extend_outside]
+  · exact tailPayload_outside K h2 d s t
+  · intro h
+    exact t.property.2 (SourceLayouts.hostRole h)
+
+theorem oldPayload_host (s : State K h2 d) (bank : Host → Streams K) (h : Host) :
+    oldPayload K h2 d s bank (hostOwner K h2 d h) =
+      fun a => s.1 h ((hostChart K h2 h).inverse a) := by
+  rw [oldPayload, InvocationPayload.realize, InvocationPayload.extend_outside]
+  · exact hostPayload_host K h2 d s h
+  · exact host_not_old K h2 d h
+
+theorem oldPayload_outside (s : State K h2 d) (bank : Host → Streams K)
+    (t : TailKey K h2 d) : oldPayload K h2 d s bank t.val = s.2.2 t := by
+  rw [oldPayload, InvocationPayload.realize, InvocationPayload.extend_outside]
+  · exact hostPayload_outside K h2 d s t
+  · exact t.property.1
+
+theorem newPayload_outside (s : State K h2 d) (t : TailKey K h2 d) :
+    newPayload K h2 d s t.val = s.2.2 t := by
+  rw [newPayload, InvocationPayload.realize, InvocationPayload.extend_outside]
+  · exact tailPayload_outside K h2 d s t
+  · exact t.property.2
+
+end SourceInvocation
diff --git a/research/lean-multi-host-source/SourceLayouts.lean b/research/lean-multi-host-source/SourceLayouts.lean
new file mode 100644
index 0000000..f39a13d
--- /dev/null
+++ b/research/lean-multi-host-source/SourceLayouts.lean
@@ -0,0 +1,93 @@
+import ParentOwnership
+import SourceConnection
+
+/-!
+Relations between the two literal owner layouts for the selected invocation.
+The 240 data owners and their actual route charts agree. Every one of the
+747 hosted helper owners lies outside the entire original active owner
+image, including its private temporary. No descriptor-uniqueness premise
+or assumed physical nonaliasing is used.
+Apache-2.0. Prepared with substantial OpenAI Codex assistance.
+-/
+namespace SourceLayouts
+open SourceConnection
+
+def dataRole (i : Data) : SourceOwnership.ActiveRole := ⟨i.val, by omega⟩
+def hostRole (h : Host) : SourceOwnership.ActiveRole := ⟨240 + h.val, by omega⟩
+
+theorem data_owner_eq (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+    (d : SourceOwnership.Vec K ≃ SourceOwnership.Vec K) (i : Data) :
+    ParentOwnership.sourceActiveOwner K h2 d (dataRole i) =
+      SourceOwnership.sourceActiveOwner K h2 d (dataRole i) := by
+  have hi : (dataRole i).val < 987 := by simp only [dataRole]; omega
+  have hid : (dataRole i).val < 240 := i.isLt
+  simp only [ParentOwnership.sourceActiveOwner, SourceOwnership.sourceActiveOwner,
+    SourceOwnership.activeOwner, dif_pos hi,
+    ParentOwnership.physicalOwner, ParentOwnership.owner,
+    SourceOwnership.physicalOwner, SourceOwnership.owner,
+    ParentOwnership.sigmaInverse, SourceOwnership.sigmaInverse, if_pos hid,
+    ParentOwnership.sourceDataCharts]
+  rw [ParentOwnership.family_data_general _ hid,
+    SourceOwnership.family_data_general _ hid]
+
+theorem data_chart_eq (K : Type) [Field K] (h2 : (2 : K) ≠ 0) (i : Data) :
+    ParentOwnership.sourceActiveAddressChart K h2 (dataRole i) =
+      SourceOwnership.sourceActiveAddressChart K h2 (dataRole i) := by
+  have hi : (dataRole i).val < 987 := by simp only [dataRole]; omega
+  have hid : (dataRole i).val < 240 := i.isLt
+  simp only [ParentOwnership.sourceActiveAddressChart,
+    SourceOwnership.sourceActiveAddressChart, ParentOwnership.sourceActiveChart,
+    SourceOwnership.sourceActiveChart, ParentOwnership.sourceActiveSigma,
+    SourceOwnership.activeSigma, dif_pos hi, ParentOwnership.actualSigma,
+    SourceOwnership.actualSigma, if_pos hid, ParentOwnership.sourceDataCharts]
+
+theorem host_family (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+    (d : SourceOwnership.Vec K ≃ SourceOwnership.Vec K) (h : Host) :
+    (SourceOwnership.sourceActiveOwner K h2 d (hostRole h)).1 =
+      SourceOwnership.family (role h) := by
+  have hh : (hostRole h).val < 987 := by simp only [hostRole]; omega
+  simp only [SourceOwnership.sourceActiveOwner, SourceOwnership.activeOwner,
+    dif_pos hh, SourceOwnership.physicalOwner, SourceOwnership.owner]
+  rfl
+
+theorem parent_owner_ne_host (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+    (d : SourceOwnership.Vec K ≃ SourceOwnership.Vec K)
+    (r : ParentOwnership.ActiveRole) (h : Host) :
+    ParentOwnership.sourceActiveOwner K h2 d r ≠
+      SourceOwnership.sourceActiveOwner K h2 d (hostRole h) := by
+  have hr : 240 ≤ (role h).val := by simp only [role]; omega
+  have hf := SourceOwnership.helper_range (role h) hr
+  have hn := ParentOwnership.sourceActiveOwner_avoids_host_families K h2 d r
+    (SourceOwnership.family (role h)) hf.1 (by omega)
+  intro he
+  apply hn
+  exact (congrArg Prod.fst he).trans (host_family K h2 d h)
+
+theorem host_ne_parent_owner (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+    (d : SourceOwnership.Vec K ≃ SourceOwnership.Vec K)
+    (h : Host) (r : ParentOwnership.ActiveRole) :
+    SourceOwnership.sourceActiveOwner K h2 d (hostRole h) ≠
+      ParentOwnership.sourceActiveOwner K h2 d r :=
+  Ne.symm (parent_owner_ne_host K h2 d r h)
+
+theorem host_chart_forward (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+    (h : Host) (a : WholeHosting.Address SourceOwnership.Axis K) :
+    (SourceOwnership.sourceActiveAddressChart K h2 (hostRole h)).forward a =
+      (SourceOwnership.familyAddressChart K h2 (SourceOwnership.family (role h))).forward
+        (SourceOwnership.reindex (SourceOwnership.tag (role h)) a) := by
+  exact SourceOwnership.helper_address_forward K h2 (hostRole h)
+    (by simp only [hostRole]; omega) (by simp only [hostRole]; omega) a
+
+theorem host_chart_inverse (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+    (h : Host) (a : WholeHosting.Address SourceOwnership.Axis K) :
+    (SourceOwnership.sourceActiveAddressChart K h2 (hostRole h)).inverse a =
+      SourceOwnership.unindex (SourceOwnership.tag (role h))
+        ((SourceOwnership.familyAddressChart K h2 (SourceOwnership.family (role h))).inverse a) := by
+  exact SourceOwnership.helper_address_inverse K h2 (hostRole h)
+    (by simp only [hostRole]; omega) (by simp only [hostRole]; omega) a
+
+#print axioms data_owner_eq
+#print axioms data_chart_eq
+#print axioms parent_owner_ne_host
+
+end SourceLayouts
diff --git a/research/lean-multi-host-source/SourceMoveGeometry.lean b/research/lean-multi-host-source/SourceMoveGeometry.lean
