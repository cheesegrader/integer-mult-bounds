+import SourceCommonCover
+import SourceInitialPayload
+import SourceRawGuards
+
+/-! The concrete owner-coordinate executions are the literal native
+instruction sequence in different coordinates. In particular ADD reads
+one native address in both physical streams; COPY/ERASE legality is proved
+along that same trajectory. Private scratch uses the explicit cover chart d.
+-/
+namespace SourceInvocation
+open SourceConnection FramedReplay OwnerTransport
+variable (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+variable (d : SourceOwnership.Vec K ≃ SourceOwnership.Vec K)
+
+noncomputable def nativePayload (cover : Slot K → Gauge (WholeHosting.Address SourceOwnership.Axis K))
+    (payload : RawPayload K) : RawPayload K := fun s a => payload s ((cover s).inverse a)
+
+def nativeGauge := AddressPairs.gauge (SourceOwnership.pairGauge d)
+
+noncomputable def oldNative (gauges : Gauges K) (s : State K h2 d) (bank : Host → Streams K) :=
+  runNative (oldOwner K h2 d) (nativeGauge K d)
+    (SourceFrameTrace.forward.map (SourceFrameTrace.toRoute gauges))
+    (SourceRaw.initial (oldOwner K h2 d) gauges
+      (nativePayload K (commonNativeCover K h2 d) (oldPayload K h2 d s bank)))
+
+noncomputable def newNative (gauges : Gauges K) (s : State K h2 d) :=
+  runNative (newOwner K h2 d) (nativeGauge K d)
+    (SourceFrameTrace.forward.map (SourceFrameTrace.toRoute gauges))
+    (SourceRaw.initial (newOwner K h2 d) gauges
+      (nativePayload K (commonNativeCover K h2 d) (newPayload K h2 d s)))
+
+omit [Field K] in
+theorem native_payload_roundtrip
+    (cover : Slot K → Gauge (WholeHosting.Address SourceOwnership.Axis K)) (payload : RawPayload K) :
+    (fun s a => nativePayload K cover payload s ((cover s).forward a)) = payload := by
+  funext s a
+  exact congrArg (payload s) ((cover s).inverse_forward a)
+
+theorem old_native_realization (gauges : Gauges K) (s : State K h2 d)
+    (bank : Host → Streams K) :
+    oldRaw K h2 d gauges s bank =
+      fromNative (commonNativeCover K h2 d)
+        (oldNative K h2 d gauges s bank) := by
+  have h := SourceRawGuards.native_run_refines (oldOwner K h2 d) (oldChart K h2)
+    gauges (commonNativeCover K h2 d) (nativeGauge K d)
+    (old_common_cover K h2 d)
+    (nativePayload K (commonNativeCover K h2 d) (oldPayload K h2 d s bank))
+  rw [native_payload_roundtrip] at h
+  exact h
+
+theorem new_native_realization (gauges : Gauges K) (s : State K h2 d) :
+    newRaw K h2 d gauges s =
+      fromNative (commonNativeCover K h2 d)
+        (newNative K h2 d gauges s) := by
+  have h := SourceRawGuards.native_run_refines (newOwner K h2 d) (newChart K h2)
+    gauges (commonNativeCover K h2 d) (nativeGauge K d)
+    (new_common_cover K h2 d)
+    (nativePayload K (commonNativeCover K h2 d) (newPayload K h2 d s))
+  rw [native_payload_roundtrip] at h
+  exact h
+
+theorem old_native_clean (gauges : Gauges K) (s : State K h2 d) (bank : Host → Streams K) :
+    SourceRawGuards.NativeCleanRun (oldOwner K h2 d) (nativeGauge K d)
+      (SourceFrameTrace.forward.map (SourceFrameTrace.toRoute gauges))
+      (SourceRaw.initial (oldOwner K h2 d) gauges
+        (nativePayload K (commonNativeCover K h2 d) (oldPayload K h2 d s bank))) :=
+  SourceRawGuards.actual_native_clean (oldOwner K h2 d) (oldChart K h2)
+    (fun h => oldOwner_injective K h2 d h) gauges
+    (commonNativeCover K h2 d) (nativeGauge K d)
+    (old_common_cover K h2 d) _
+
+theorem new_native_clean (gauges : Gauges K) (s : State K h2 d) :
+    SourceRawGuards.NativeCleanRun (newOwner K h2 d) (nativeGauge K d)
+      (SourceFrameTrace.forward.map (SourceFrameTrace.toRoute gauges))
+      (SourceRaw.initial (newOwner K h2 d) gauges
+        (nativePayload K (commonNativeCover K h2 d) (newPayload K h2 d s))) :=
+  SourceRawGuards.actual_native_clean (newOwner K h2 d) (newChart K h2)
+    (fun h => newOwner_injective K h2 d h) gauges
+    (commonNativeCover K h2 d) (nativeGauge K d)
+    (new_common_cover K h2 d) _
+
+theorem old_native_temporary_restored (gauges : Gauges K) (s : State K h2 d)
+    (bank : Host → Streams K) :
+    (oldNative K h2 d gauges s bank (oldOwner K h2 d SourceRaw.privateRow)).2 = fun _ => false :=
+  SourceRawGuards.native_private_restored (oldOwner K h2 d) (oldChart K h2)
+    (fun h => oldOwner_injective K h2 d h) gauges
+    (commonNativeCover K h2 d) (nativeGauge K d)
+    (old_common_cover K h2 d) _
+
+theorem new_native_temporary_restored (gauges : Gauges K) (s : State K h2 d) :
+    (newNative K h2 d gauges s (newOwner K h2 d SourceRaw.privateRow)).2 = fun _ => false :=
+  SourceRawGuards.native_private_restored (newOwner K h2 d) (newChart K h2)
+    (fun h => newOwner_injective K h2 d h) gauges
+    (commonNativeCover K h2 d) (nativeGauge K d)
+    (new_common_cover K h2 d) _
+
+/-- The original and hosted native executions start from the same dirty
+physical payload at every retained host. A single cover chart is essential
+here; independent extensions outside each active image would not suffice. -/
+theorem native_shared_host_input (s : State K h2 d) (bank : Host → Streams K) (h : Host) :
+    nativePayload K (commonNativeCover K h2 d) (oldPayload K h2 d s bank)
+      (hostOwner K h2 d h) =
+    nativePayload K (commonNativeCover K h2 d) (newPayload K h2 d s)
+      (hostOwner K h2 d h) := by
+  funext a
+  exact congrFun (shared_host_input K h2 d s bank h) _
+
+theorem native_shared_data_input (s : State K h2 d) (bank : Host → Streams K) (i : Data) :
+    nativePayload K (commonNativeCover K h2 d) (oldPayload K h2 d s bank)
+      (oldOwner K h2 d (SourceLayouts.dataRole i)) =
+    nativePayload K (commonNativeCover K h2 d) (newPayload K h2 d s)
+      (newOwner K h2 d (SourceLayouts.dataRole i)) := by
+  have ho : oldOwner K h2 d (SourceLayouts.dataRole i) =
+      newOwner K h2 d (SourceLayouts.dataRole i) := SourceLayouts.data_owner_eq K h2 d i
+  funext a
+  change oldPayload K h2 d s bank _ ((commonNativeCover K h2 d _).inverse a) =
+    newPayload K h2 d s _ ((commonNativeCover K h2 d _).inverse a)
+  rw [oldPayload_data, newPayload_data, ho]
+
+theorem native_shared_tail_input (s : State K h2 d) (bank : Host → Streams K)
+    (t : TailKey K h2 d) :
+    nativePayload K (commonNativeCover K h2 d) (oldPayload K h2 d s bank) t.val =
+    nativePayload K (commonNativeCover K h2 d) (newPayload K h2 d s) t.val := by
+  funext a
+  exact congrFun ((oldPayload_outside K h2 d s bank t).trans
+    (newPayload_outside K h2 d s t).symm) _
+
+/-- The private-row initialization also preserves those shared retained
+inputs. This statement concerns the actual initialized native states. -/
+theorem initialized_native_host_input (gauges : Gauges K)
+    (s : State K h2 d) (bank : Host → Streams K) (h : Host) :
+    (SourceRaw.initial (oldOwner K h2 d) gauges
+      (nativePayload K (commonNativeCover K h2 d) (oldPayload K h2 d s bank))
+      (hostOwner K h2 d h)).2 =
+    (SourceRaw.initial (newOwner K h2 d) gauges
+      (nativePayload K (commonNativeCover K h2 d) (newPayload K h2 d s))
+      (hostOwner K h2 d h)).2 := by
+  have hn : hostOwner K h2 d h ≠ newOwner K h2 d SourceRaw.privateRow := by
+    intro he
+    have hv := congrArg Fin.val (newOwner_injective K h2 d he)
+    change 240 + h.val = 987 at hv
+    omega
+  exact (OwnerTransport.initialRaw_other (oldOwner K h2 d) (SourceRaw.frames gauges)
+    SourceRaw.privateRow _ _ (host_not_old K h2 d h SourceRaw.privateRow)).trans
+      ((native_shared_host_input K h2 d s bank h).trans
+        (OwnerTransport.initialRaw_other (newOwner K h2 d) (SourceRaw.frames gauges)
+          SourceRaw.privateRow _ _ hn).symm)
+
+theorem initialized_native_data_input (gauges : Gauges K)
+    (s : State K h2 d) (bank : Host → Streams K) (i : Data) :
+    (SourceRaw.initial (oldOwner K h2 d) gauges
+      (nativePayload K (commonNativeCover K h2 d) (oldPayload K h2 d s bank))
+      (oldOwner K h2 d (SourceLayouts.dataRole i))).2 =
+    (SourceRaw.initial (newOwner K h2 d) gauges
+      (nativePayload K (commonNativeCover K h2 d) (newPayload K h2 d s))
+      (newOwner K h2 d (SourceLayouts.dataRole i))).2 := by
+  have ho : oldOwner K h2 d (SourceLayouts.dataRole i) ≠
+      oldOwner K h2 d SourceRaw.privateRow := by
+    intro he
+    have hv := congrArg Fin.val (oldOwner_injective K h2 d he)
+    change i.val = 987 at hv
+    omega
+  have hn : newOwner K h2 d (SourceLayouts.dataRole i) ≠
+      newOwner K h2 d SourceRaw.privateRow := by
+    intro he
+    have hv := congrArg Fin.val (newOwner_injective K h2 d he)
+    change i.val = 987 at hv
+    omega
+  exact (OwnerTransport.initialRaw_other (oldOwner K h2 d) (SourceRaw.frames gauges)
+    SourceRaw.privateRow _ _ ho).trans
+      ((native_shared_data_input K h2 d s bank i).trans
+        (OwnerTransport.initialRaw_other (newOwner K h2 d) (SourceRaw.frames gauges)
+          SourceRaw.privateRow _ _ hn).symm)
+
+theorem initialized_native_tail_input (gauges : Gauges K)
+    (s : State K h2 d) (bank : Host → Streams K) (t : TailKey K h2 d) :
+    (SourceRaw.initial (oldOwner K h2 d) gauges
+      (nativePayload K (commonNativeCover K h2 d) (oldPayload K h2 d s bank)) t.val).2 =
+    (SourceRaw.initial (newOwner K h2 d) gauges
+      (nativePayload K (commonNativeCover K h2 d) (newPayload K h2 d s)) t.val).2 := by
+  exact (OwnerTransport.initialRaw_other (oldOwner K h2 d) (SourceRaw.frames gauges)
+    SourceRaw.privateRow _ _ (t.property.1 SourceRaw.privateRow)).trans
+      ((native_shared_tail_input K h2 d s bank t).trans
+        (OwnerTransport.initialRaw_other (newOwner K h2 d) (SourceRaw.frames gauges)
+          SourceRaw.privateRow _ _ (t.property.2 SourceRaw.privateRow)).symm)
+
+/-- Native outputs are read in the same fixed retained coordinate charts.
+The definition spells out the read-back from the native instruction fold. -/
+noncomputable def oldNativeResult (gauges : Gauges K)
+    (sb : State K h2 d × (Host → Streams K)) : State K h2 d × (Host → Streams K) :=
+  let raw := fromNative (commonNativeCover K h2 d) (oldNative K h2 d gauges sb.1 sb.2)
+  ((fun h a => (raw (hostOwner K h2 d h)).2 ((hostChart K h2 h).forward a),
+    (fun i => (raw (oldOwner K h2 d (SourceLayouts.dataRole i))).2,
+      fun t => (raw t.val).2)),
+    fun h => (raw (oldOwner K h2 d (SourceLayouts.hostRole h))).2)
+
+noncomputable def newNativeResult (gauges : Gauges K)
+    (sb : State K h2 d × Unit) : State K h2 d × Unit :=
+  let raw := fromNative (commonNativeCover K h2 d) (newNative K h2 d gauges sb.1)
+  ((fun h a => (raw (hostOwner K h2 d h)).2 ((hostChart K h2 h).forward a),
+    (fun i => (raw (newOwner K h2 d (SourceLayouts.dataRole i))).2,
+      fun t => (raw t.val).2)), sb.2)
+
+theorem oldResult_native (gauges : Gauges K) (s : State K h2 d) (bank : Host → Streams K) :
+    oldResult K h2 d gauges (s, bank) = oldNativeResult K h2 d gauges (s, bank) := by
+  exact congrArg (fun raw : Raw (Slot K) (WholeHosting.Address SourceOwnership.Axis K) =>
+    ((fun h a => (raw (hostOwner K h2 d h)).2 ((hostChart K h2 h).forward a),
+      (fun i => (raw (oldOwner K h2 d (SourceLayouts.dataRole i))).2,
+        fun t : TailKey K h2 d => (raw t.val).2)),
+      fun h => (raw (oldOwner K h2 d (SourceLayouts.hostRole h))).2))
+    (old_native_realization K h2 d gauges s bank)
+
+theorem newResult_native (gauges : Gauges K) (s : State K h2 d) (bank : Unit) :
+    newResult K h2 d gauges (s, bank) = newNativeResult K h2 d gauges (s, bank) := by
+  exact congrArg (fun raw : Raw (Slot K) (WholeHosting.Address SourceOwnership.Axis K) =>
+    ((fun h a => (raw (hostOwner K h2 d h)).2 ((hostChart K h2 h).forward a),
+      (fun i => (raw (newOwner K h2 d (SourceLayouts.dataRole i))).2,
+        fun t : TailKey K h2 d => (raw t.val).2)), bank))
+    (new_native_realization K h2 d gauges s)
+
+end SourceInvocation
diff --git a/research/lean-multi-host-source/SourceRaw.lean b/research/lean-multi-host-source/SourceRaw.lean
new file mode 100644
index 0000000..38c2824
--- /dev/null
+++ b/research/lean-multi-host-source/SourceRaw.lean
@@ -0,0 +1,124 @@
+import SourceFramed
+import FrameTraceRoutes
+import OwnerTransport
+
+/-!
+Whole-word realization on distinct raw physical owners, with arbitrary
+payloads on every original and exterior stream. There is one designated
+initially blank private row987. Frame labels are initialized metadata, not
+constraints on dirty contents. The final SourceInvocation module supplies
+the source-specific owner/chart maps; this module assumes their injectivity.
+-/
+namespace SourceRaw
+open TreeReplay (Tree)
+open FramedReplay OwnerTransport
+set_option maxRecDepth 100000
+set_option maxHeartbeats 0
+
+abbrev Role := Fin 988
+def privateRow : Role := ⟨987, by decide⟩
+
+def frames {X : Type} (gauges : Nat → Gauge X) (r : Role) : Gauge X :=
+  gauges (SourceFrameTrace.state0.frames.get r.val)
+
+def input {S X : Type} (owner : Role → S) (chart : Role → Gauge X)
+    (payload : S → X → Bool) (i : Nat) : X → Bool :=
+  if hi : i < 988 then fun a => payload (owner ⟨i, hi⟩) ((chart ⟨i, hi⟩).forward a)
+  else fun _ => false
+
+noncomputable def initial {S X : Type} (owner : Role → S)
+    (gauges : Nat → Gauge X) (payload : S → X → Bool) : Raw S X :=
+  initialRaw owner (frames gauges) privateRow payload
+
+noncomputable def final {S X : Type} (owner : Role → S) (chart : Role → Gauge X)
+    (gauges : Nat → Gauge X) (payload : S → X → Bool) : Raw S X :=
+  runRaw owner chart (SourceFrameTrace.forward.map (SourceFrameTrace.toRoute gauges))
+    (initial owner gauges payload)
+
+theorem gather_initial {S X : Type} (owner : Role → S) (chart : Role → Gauge X)
+    (hinj : ∀ {r s}, owner r = owner s → r = s)
+    (gauges : Nat → Gauge X) (payload : S → X → Bool) (r : Role) :
+    gather owner chart (initial owner gauges payload) r =
+      (SourceFramed.initial gauges (input owner chart payload)).get r.val := by
+  rw [initial, gather_initialRaw owner chart hinj]
+  rw [SourceFramed.initial, Tree.get_tabulate 10 _ r.val (by omega)]
+  by_cases hr : r = privateRow
+  · subst r
+    simp only [privateRow, frames, ↓reduceIte, Nat.lt_irrefl]
+  · have hval : r.val < 987 := by
+      have hn : r.val ≠ 987 := fun h => hr (Fin.ext h)
+      omega
+    simp only [frames, if_neg hr, if_pos hval, input, dif_pos r.isLt]
+
+/-- Every physical role follows the exact chronological framed source word.
+The finite-role projection is an equality of the literal event lists. -/
+theorem gather_final {S X : Type} (owner : Role → S) (chart : Role → Gauge X)
+    (hinj : ∀ {r s}, owner r = owner s → r = s)
+    (gauges : Nat → Gauge X) (payload : S → X → Bool) (r : Role) :
+    gather owner chart (final owner chart gauges payload) r =
+      (SourceFramed.final gauges (input owner chart payload)).get r.val := by
+  have h := gather_run_framed owner chart hinj
+    (SourceFrameTrace.forward.map (SourceFrameTrace.toRoute gauges))
+    (initial owner gauges payload)
+    (SourceFramed.initial gauges (input owner chart payload)) 10
+    (Tree.full_tabulate _ _) (by decide)
+    (gather_initial owner chart hinj gauges payload) r
+  rw [SourceFrameTrace.route_projection] at h
+  exact h
+
+/-- The same execution satisfies every COPY/ERASE guard for arbitrary dirty
+payloads, including correlations among original and retained exterior rows. -/
+theorem actual_valid {S X : Type} (owner : Role → S) (chart : Role → Gauge X)
+    (gauges : Nat → Gauge X) (payload : S → X → Bool) :
+    FramedReplay.ValidTrace
+      (SourceFrameTrace.forward.map (FrameTrace.toPhysical gauges))
+      (SourceFramed.initial gauges (input owner chart payload)) :=
+  SourceFramed.actual_valid gauges _
+
+/-- Exact raw payload endpoint. The inverse chart is the proved scatter
+map; all dirty inputs remain universally quantified. -/
+theorem payload_endpoint {S X : Type} (owner : Role → S) (chart : Role → Gauge X)
+    (hinj : ∀ {r s}, owner r = owner s → r = s)
+    (gauges : Nat → Gauge X) (payload : S → X → Bool) (r : Role) (a : X) :
+    (final owner chart gauges payload (owner r)).2 a =
+      SourceMatrix.endpointPayload
+        (SourceFramed.normalizedInput gauges (input owner chart payload)) r.val
+        ((gauges (SourceFrameTrace.state96.frames.get r.val)).inverse
+          ((chart r).inverse a)) := by
+  have h := congrArg Prod.snd (gather_final owner chart hinj gauges payload r)
+  have ha := congrFun h ((chart r).inverse a)
+  simp only [gather, (chart r).forward_inverse] at ha
+  rw [ha]
+  exact SourceFramed.actual_physical_endpoint gauges _ r.val (by omega) _
+
+theorem private_restored {S X : Type} (owner : Role → S) (chart : Role → Gauge X)
+    (hinj : ∀ {r s}, owner r = owner s → r = s)
+    (gauges : Nat → Gauge X) (payload : S → X → Bool) :
+    (final owner chart gauges payload (owner privateRow)).2 = fun _ => false := by
+  funext a
+  rw [payload_endpoint owner chart hinj gauges payload privateRow a]
+  rfl
+
+/-- Every row outside the actual owner image is preserved, including its
+payload and metadata. This supplies the retained exterior state. -/
+theorem other_preserved {S X : Type} (owner : Role → S) (chart : Role → Gauge X)
+    (gauges : Nat → Gauge X) (payload : S → X → Bool) (s : S)
+    (outside : ∀ r, s ≠ owner r) :
+    final owner chart gauges payload s = initial owner gauges payload s :=
+  runRaw_other owner chart _ _ s outside
+
+theorem other_payload_preserved {S X : Type} (owner : Role → S) (chart : Role → Gauge X)
+    (gauges : Nat → Gauge X) (payload : S → X → Bool) (s : S)
+    (outside : ∀ r, s ≠ owner r) :
+    (final owner chart gauges payload s).2 = payload s := by
+  rw [other_preserved owner chart gauges payload s outside]
+  exact initialRaw_other owner (frames gauges) privateRow payload s (outside privateRow)
+
+#print axioms gather_initial
+#print axioms gather_final
+#print axioms actual_valid
+#print axioms payload_endpoint
+#print axioms private_restored
+#print axioms other_preserved
+#print axioms other_payload_preserved
+end SourceRaw
diff --git a/research/lean-multi-host-source/SourceRawGuards.lean b/research/lean-multi-host-source/SourceRawGuards.lean
new file mode 100644
index 0000000..f3402e0
--- /dev/null
+++ b/research/lean-multi-host-source/SourceRawGuards.lean
@@ -0,0 +1,216 @@
+import SourceRaw
+
+/-! COPY blankness and ERASE uncomputation guards along the actual raw and
+native executions. Guards follow each preceding physical output; no fresh
+reinitialization or endpoint assumption is inserted between events. -/
+namespace SourceRawGuards
+open FramedReplay OwnerTransport
+set_option maxRecDepth 100000
+set_option maxHeartbeats 0
+
+def RawClean {R S X : Type} (owner : R → S) (chart : R → Gauge X)
+    (raw : Raw S X) (e : RouteEvent R X) : Prop :=
+  (e.op = 2 → (raw (owner e.y)).2 = fun _ => false) ∧
+  (e.op = 3 → ∀ a, (raw (owner e.y)).2 a =
+    (raw (owner e.x)).2 ((chart e.x).forward
+      ((raw (owner e.x)).1.forward ((raw (owner e.y)).1.inverse
+        ((chart e.y).inverse a)))))
+
+noncomputable def RawCleanRun {R S X : Type} (owner : R → S) (chart : R → Gauge X) :
+    List (RouteEvent R X) → Raw S X → Prop
+  | [], _ => True
+  | e :: es, raw => RawClean owner chart raw e ∧ RawCleanRun owner chart es
+      (rawStep owner chart raw e.op e.x e.y e.odd e.newFrame)
+
+theorem raw_clean_of_framed {n : Nat} {S X : Type} (owner : Fin n → S)
+    (chart : Fin n → Gauge X) (raw : Raw S X) (s : Store X)
+    (rel : ∀ r, gather owner chart raw r = s.get r.val)
+    (e : RouteEvent (Fin n) X) (valid : ValidStep s e.framed) :
+    RawClean owner chart raw e := by
+  constructor
+  · intro hop
+    have hv : decodeRow (s.get e.y.val) = fun _ => false := by
+      simpa only [ValidStep, RouteEvent.framed, hop] using valid
+    have hg : decodeRow (gather owner chart raw e.y) = fun _ => false := by
+      rw [rel]; exact hv
+    funext a
+    have h := physical_blank_of_decoded_blank _ hg ((chart e.y).inverse a)
+    simpa only [gather, (chart e.y).forward_inverse] using h
+  · intro hop a
+    have hv : decodeRow (s.get e.x.val) = decodeRow (s.get e.y.val) := by
+      simpa only [ValidStep, RouteEvent.framed, hop] using valid
+    have hg : decodeRow (gather owner chart raw e.x) =
+        decodeRow (gather owner chart raw e.y) := by
+      rw [rel, rel]; exact hv
+    have h := erase_guard_transport _ _ hg ((chart e.y).inverse a)
+    simpa only [gather, (chart e.y).forward_inverse] using h
+
+theorem raw_clean_run_of_framed {n : Nat} {S X : Type} (owner : Fin n → S)
+    (chart : Fin n → Gauge X) (hinj : ∀ {r s}, owner r = owner s → r = s)
+    (events : List (RouteEvent (Fin n) X)) (raw : Raw S X)
+    (s : Store X) (depth : Nat) (full : TreeReplay.Tree.Full depth s)
+    (bound : n ≤ 2 ^ depth) (rel : ∀ r, gather owner chart raw r = s.get r.val)
+    (valid : ValidTrace (events.map RouteEvent.framed) s) :
+    RawCleanRun owner chart events raw := by
+  induction events generalizing raw s with
+  | nil => trivial
+  | cons e es ih =>
+      refine ⟨raw_clean_of_framed owner chart raw s rel e valid.1, ?_⟩
+      apply ih _ _ (physicalStep_full s depth full e.framed) _ valid.2
+      intro r
+      rw [congrFun (gather_step owner chart hinj raw e.op e.x e.y e.odd e.newFrame) r]
+      exact logicalStep_fin_tree s depth full bound _ rel e r
+
+def NativeClean {R S X : Type} (owner : R → S) (d : Gauge X)
+    (native : Raw S X) (e : RouteEvent R X) : Prop :=
+  (e.op = 2 → (native (owner e.y)).2 = fun _ => false) ∧
+  (e.op = 3 → ∀ a, (native (owner e.y)).2 a =
+    (native (owner e.x)).2 (d.forward
+      ((native (owner e.x)).1.forward ((native (owner e.y)).1.inverse (d.inverse a)))))
+
+noncomputable def NativeCleanRun {R S X : Type} (owner : R → S) (d : Gauge X) :
+    List (RouteEvent R X) → Raw S X → Prop
+  | [], _ => True
+  | e :: es, native => NativeClean owner d native e ∧ NativeCleanRun owner d es
+      (nativeStep owner d native e.op e.x e.y e.odd e.newFrame)
+
+theorem native_clean_of_raw {R S X : Type} (owner : R → S)
+    (chart : R → Gauge X) (cover : S → Gauge X) (d : Gauge X)
+    (common : ∀ r a, (cover (owner r)).forward ((chart r).forward a) = d.forward a)
+    (native : Raw S X) (e : RouteEvent R X)
+    (clean : RawClean owner chart (fromNative cover native) e) :
+    NativeClean owner d native e := by
+  constructor
+  · intro hop
+    funext a
+    have h := congrFun (clean.1 hop) ((cover (owner e.y)).inverse a)
+    simpa only [fromNative, (cover (owner e.y)).forward_inverse] using h
+  · intro hop a
+    have h := clean.2 hop ((cover (owner e.y)).inverse a)
+    simp only [fromNative, (cover (owner e.y)).forward_inverse] at h
+    rw [common, inverse_common_cover owner chart cover d common e.y a] at h
+    exact h
+
+theorem native_clean_run_of_raw {R S X : Type} (owner : R → S)
+    (chart : R → Gauge X) (cover : S → Gauge X) (d : Gauge X)
+    (common : ∀ r a, (cover (owner r)).forward ((chart r).forward a) = d.forward a)
+    (events : List (RouteEvent R X)) (native : Raw S X)
+    (clean : RawCleanRun owner chart events (fromNative cover native)) :
+    NativeCleanRun owner d events native := by
+  induction events generalizing native with
+  | nil => trivial
+  | cons e es ih =>
+      refine ⟨native_clean_of_raw owner chart cover d common native e clean.1, ?_⟩
+      apply ih
+      have h := clean.2
+      rw [rawStep_fromNative owner chart cover d common] at h
+      exact h
+
+theorem actual_raw_clean {S X : Type} (owner : SourceRaw.Role → S)
+    (chart : SourceRaw.Role → Gauge X) (hinj : ∀ {r s}, owner r = owner s → r = s)
+    (gauges : Nat → Gauge X) (payload : S → X → Bool) :
+    RawCleanRun owner chart (SourceFrameTrace.forward.map (SourceFrameTrace.toRoute gauges))
+      (SourceRaw.initial owner gauges payload) := by
+  apply raw_clean_run_of_framed owner chart hinj _ _
+    (SourceFramed.initial gauges (SourceRaw.input owner chart payload)) 10
+    (TreeReplay.Tree.full_tabulate _ _) (by decide)
+    (SourceRaw.gather_initial owner chart hinj gauges payload)
+  rw [SourceFrameTrace.route_projection]
+  exact SourceFramed.actual_valid gauges _
+
+/-- Preparing a blank private row and the fixed frame metadata commutes
+with expressing all physical streams in their cover charts. -/
+theorem initial_fromNative {S X : Type} (owner : SourceRaw.Role → S)
+    (gauges : Nat → Gauge X) (cover : S → Gauge X) (payload : S → X → Bool) :
+    SourceRaw.initial owner gauges (fun s a => payload s ((cover s).forward a)) =
+      fromNative cover (SourceRaw.initial owner gauges payload) := by
+  classical
+  funext s
+  by_cases hs : s = owner SourceRaw.privateRow <;>
+    simp only [SourceRaw.initial, initialRaw, fromNative, hs, ↓reduceIte]
+
+theorem actual_native_clean {S X : Type} (owner : SourceRaw.Role → S)
+    (chart : SourceRaw.Role → Gauge X) (hinj : ∀ {r s}, owner r = owner s → r = s)
+    (gauges : Nat → Gauge X) (cover : S → Gauge X) (d : Gauge X)
+    (common : ∀ r a, (cover (owner r)).forward ((chart r).forward a) = d.forward a)
+    (payload : S → X → Bool) :
+    NativeCleanRun owner d (SourceFrameTrace.forward.map (SourceFrameTrace.toRoute gauges))
+      (SourceRaw.initial owner gauges payload) := by
+  apply native_clean_run_of_raw owner chart cover d common
+  rw [← initial_fromNative]
+  exact actual_raw_clean owner chart hinj gauges _
+
+theorem native_run_refines {S X : Type} (owner : SourceRaw.Role → S)
+    (chart : SourceRaw.Role → Gauge X) (gauges : Nat → Gauge X)
+    (cover : S → Gauge X) (d : Gauge X)
+    (common : ∀ r a, (cover (owner r)).forward ((chart r).forward a) = d.forward a)
+    (payload : S → X → Bool) :
+    SourceRaw.final owner chart gauges (fun s a => payload s ((cover s).forward a)) =
+      fromNative cover (runNative owner d
+        (SourceFrameTrace.forward.map (SourceFrameTrace.toRoute gauges))
+        (SourceRaw.initial owner gauges payload)) := by
+  unfold SourceRaw.final
+  rw [initial_fromNative, runRaw_fromNative owner chart cover d common]
+
+/-- Exact source-native endpoint, derived from the same native execution
+whose physical COPY/ERASE guards were checked above. -/
+theorem native_payload_endpoint {S X : Type} (owner : SourceRaw.Role → S)
+    (chart : SourceRaw.Role → Gauge X) (hinj : ∀ {r s}, owner r = owner s → r = s)
+    (gauges : Nat → Gauge X) (cover : S → Gauge X) (d : Gauge X)
+    (common : ∀ r a, (cover (owner r)).forward ((chart r).forward a) = d.forward a)
+    (payload : S → X → Bool) (r : SourceRaw.Role) (a : X) :
+    ((runNative owner d
+      (SourceFrameTrace.forward.map (SourceFrameTrace.toRoute gauges))
+      (SourceRaw.initial owner gauges payload)) (owner r)).2 a =
+    SourceMatrix.endpointPayload
+      (SourceFramed.normalizedInput gauges (SourceRaw.input owner chart
+        (fun s a => payload s ((cover s).forward a)))) r.val
+      ((gauges (SourceFrameTrace.state96.frames.get r.val)).inverse (d.inverse a)) := by
+  have h := SourceRaw.payload_endpoint owner chart hinj gauges
+    (fun s a => payload s ((cover s).forward a)) r ((cover (owner r)).inverse a)
+  rw [native_run_refines owner chart gauges cover d common] at h
+  simp only [fromNative, (cover (owner r)).forward_inverse] at h
+  rw [inverse_common_cover owner chart cover d common] at h
+  exact h
+
+theorem native_private_restored {S X : Type} (owner : SourceRaw.Role → S)
+    (chart : SourceRaw.Role → Gauge X) (hinj : ∀ {r s}, owner r = owner s → r = s)
+    (gauges : Nat → Gauge X) (cover : S → Gauge X) (d : Gauge X)
+    (common : ∀ r a, (cover (owner r)).forward ((chart r).forward a) = d.forward a)
+    (payload : S → X → Bool) :
+    ((runNative owner d
+      (SourceFrameTrace.forward.map (SourceFrameTrace.toRoute gauges))
+      (SourceRaw.initial owner gauges payload)) (owner SourceRaw.privateRow)).2 =
+        fun _ => false := by
+  funext a
+  rw [native_payload_endpoint owner chart hinj gauges cover d common payload
+    SourceRaw.privateRow a]
+  rfl
+
+theorem native_other_preserved {S X : Type} (owner : SourceRaw.Role → S)
+    (chart : SourceRaw.Role → Gauge X) (gauges : Nat → Gauge X)
+    (cover : S → Gauge X) (d : Gauge X)
+    (common : ∀ r a, (cover (owner r)).forward ((chart r).forward a) = d.forward a)
+    (payload : S → X → Bool) (s : S) (outside : ∀ r, s ≠ owner r) :
+    ((runNative owner d
+      (SourceFrameTrace.forward.map (SourceFrameTrace.toRoute gauges))
+      (SourceRaw.initial owner gauges payload)) s).2 = payload s := by
+  have h := SourceRaw.other_payload_preserved owner chart gauges
+    (fun s a => payload s ((cover s).forward a)) s outside
+  rw [native_run_refines owner chart gauges cover d common] at h
+  funext a
+  have ha := congrFun h ((cover s).inverse a)
+  simpa only [fromNative, (cover s).forward_inverse] using ha
+
