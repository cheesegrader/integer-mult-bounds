--- /dev/null
+++ b/research/lean-multi-host-source/SourceCommonCover.lean
@@ -0,0 +1,114 @@
+import SourceInvocationState
+
+/-!
+One physical native-coordinate convention for both executions. The two
+active owner images overlap exactly on their common data roles. In
+particular the hosted private key 9457 is outside the selected original
+bank families, whose literal maximum is 9315. A shared cover extension is
+essential: choosing identity independently on each inactive image would
+give different native interpretations to the same retained host payload.
+Apache-2.0. Prepared with substantial OpenAI Codex assistance.
+-/
+namespace SourceInvocation
+open SourceConnection FramedReplay
+set_option maxRecDepth 100000
+set_option maxHeartbeats 0
+
+variable (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+variable (d : SourceOwnership.Vec K ≃ SourceOwnership.Vec K)
+
+theorem parent_family_lt_private : ∀ r : ParentOwnership.Role,
+    ParentOwnership.family r < 9457 := by decide
+
+/-- Equality of actual owner keys forces the same data role on both sides;
+no original helper or either private temporary participates in an overlap. -/
+theorem owner_overlap_data (r s : SourceRaw.Role)
+    (he : oldOwner K h2 d r = newOwner K h2 d s) :
+    ∃ i : Data, r = SourceLayouts.dataRole i ∧ s = SourceLayouts.dataRole i := by
+  have hf := congrArg Prod.fst he
+  by_cases hr : r.val < 987
+  · by_cases hs : s.val < 987
+    · simp only [oldOwner, newOwner, ParentOwnership.sourceActiveOwner,
+        SourceOwnership.sourceActiveOwner, SourceOwnership.activeOwner,
+        dif_pos hr, dif_pos hs, ParentOwnership.physicalOwner, ParentOwnership.owner,
+        SourceOwnership.physicalOwner, SourceOwnership.owner] at hf
+      have hn := SourceOwnership.family_lt (⟨s.val, hs⟩ : SourceOwnership.Role)
+      have hrd : r.val < 240 := by
+        by_contra nh
+        have ho := (ParentOwnership.helper_range ⟨r.val, hr⟩
+          (show 240 ≤ r.val from Nat.le_of_not_lt nh)).1
+        omega
+      rw [ParentOwnership.family_data_general _ hrd] at hf
+      have hsd : s.val < 240 := by
+        by_contra nh
+        have ho := (SourceOwnership.helper_range ⟨s.val, hs⟩
+          (show 240 ≤ s.val from Nat.le_of_not_lt nh)).1
+        change r.val = SourceOwnership.family ⟨s.val, hs⟩ at hf
+        omega
+      rw [SourceOwnership.family_data_general _ hsd] at hf
+      refine ⟨⟨r.val, hrd⟩, ?_, ?_⟩
+      · apply Fin.ext; rfl
+      · apply Fin.ext; exact hf.symm
+    · simp only [oldOwner, newOwner, ParentOwnership.sourceActiveOwner,
+        SourceOwnership.sourceActiveOwner, SourceOwnership.activeOwner,
+        dif_pos hr, dif_neg hs, ParentOwnership.physicalOwner, ParentOwnership.owner] at hf
+      have hp := parent_family_lt_private ⟨r.val, hr⟩
+      omega
+  · by_cases hs : s.val < 987
+    · simp only [oldOwner, newOwner, ParentOwnership.sourceActiveOwner,
+        SourceOwnership.sourceActiveOwner, SourceOwnership.activeOwner,
+        dif_neg hr, dif_pos hs, SourceOwnership.physicalOwner, SourceOwnership.owner] at hf
+      have hn := SourceOwnership.family_lt (⟨s.val, hs⟩ : SourceOwnership.Role)
+      omega
+    · simp only [oldOwner, newOwner, ParentOwnership.sourceActiveOwner,
+        SourceOwnership.sourceActiveOwner, SourceOwnership.activeOwner,
+        dif_neg hr, dif_neg hs] at hf
+      omega
+
+theorem owner_overlap_charts (r s : SourceRaw.Role)
+    (he : oldOwner K h2 d r = newOwner K h2 d s) :
+    oldChart K h2 r = newChart K h2 s := by
+  obtain ⟨i, rfl, rfl⟩ := owner_overlap_data K h2 d r s he
+  exact SourceLayouts.data_chart_eq K h2 i
+
+noncomputable def commonNativeCover :
+    Slot K → Gauge (WholeHosting.Address SourceOwnership.Axis K) := by
+  classical
+  exact fun p => if ∃ r, newOwner K h2 d r = p then
+    SourceOwnership.sourceNativeCover K h2 d p
+  else ParentOwnership.sourceNativeCover K h2 d p
+
+theorem commonNativeCover_new (r : SourceRaw.Role) :
+    commonNativeCover K h2 d (newOwner K h2 d r) =
+      SourceOwnership.sourceNativeCover K h2 d (newOwner K h2 d r) := by
+  classical
+  exact if_pos ⟨r, rfl⟩
+
+theorem new_common_cover (r : SourceRaw.Role)
+    (a : WholeHosting.Address SourceOwnership.Axis K) :
+    (commonNativeCover K h2 d (newOwner K h2 d r)).forward
+      ((newChart K h2 r).forward a) =
+      (AddressPairs.gauge (SourceOwnership.pairGauge d)).forward a := by
+  rw [commonNativeCover_new]
+  exact SourceOwnership.source_common_cover K h2 d r a
+
+theorem old_common_cover (r : SourceRaw.Role)
+    (a : WholeHosting.Address SourceOwnership.Axis K) :
+    (commonNativeCover K h2 d (oldOwner K h2 d r)).forward
+      ((oldChart K h2 r).forward a) =
+      (AddressPairs.gauge (SourceOwnership.pairGauge d)).forward a := by
+  classical
+  unfold commonNativeCover
+  split
+  · next h =>
+      obtain ⟨s, he⟩ := h
+      rw [owner_overlap_charts K h2 d r s he.symm, ← he]
+      exact SourceOwnership.source_common_cover K h2 d s a
+  · exact ParentOwnership.source_common_cover K h2 d r a
+
+#print axioms parent_family_lt_private
+#print axioms owner_overlap_data
+#print axioms old_common_cover
+#print axioms new_common_cover
+
+end SourceInvocation
diff --git a/research/lean-multi-host-source/SourceConnection.lean b/research/lean-multi-host-source/SourceConnection.lean
new file mode 100644
index 0000000..7eb5c83
--- /dev/null
+++ b/research/lean-multi-host-source/SourceConnection.lean
@@ -0,0 +1,193 @@
+import SourceEndpoint
+import MultiHosting
+import Ownership
+
+/-!
+The literal normalized invocation supplies the complete, arbitrary-input
+endpoint for all 747 helper roles and all 240 data roles. The adapters below
+express gather/scatter in the fixed owner charts. Their identification with
+the physical source execution is a separate theorem: in particular, the
+actual initial/final frames must implement `hostOutput`, and the source's
+owner charts must implement `hostInput`. The adapter must not be reported
+as that physical identification by itself.
+
+In particular, the literal physical initial decoder also contains its
+initial frame. `hostInput` below is a convenient normalized representative,
+not a claim about intermediate physical inputs. Connecting the two uses the
+proved independence of data outputs from every dirty helper and the proved
+identity on every normalized helper, followed by the actual initial/final
+frame composition. The clean temporary is restored by
+`SourceMatrix.arbitrary_dirty_temp_restored` and its chronological guards by
+`SourceMatrix.actual_payload_clean`.
+-/
+namespace SourceConnection
+open TreeReplay WholeHosting
+set_option maxRecDepth 100000
+set_option maxHeartbeats 0
+
+abbrev Host := Fin 747
+abbrev Data := Fin 240
+abbrev Values (X : Type u) := X → Bool
+
+def packed {X : Type u} (data : Data → Values X) (helpers : Host → Values X)
+    (i : Nat) : Values X :=
+  if hi : i < 240 then data ⟨i, hi⟩
+  else if hr : i < 987 then helpers ⟨i - 240, by omega⟩
+  else fun _ => false
+
+theorem packed_data {X : Type u} (data : Data → Values X) (helpers : Host → Values X)
+    (i : Data) : packed data helpers i.val = data i := by
+  simp [packed, i.isLt]
+
+theorem packed_helper {X : Type u} (data : Data → Values X) (helpers : Host → Values X)
+    (h : Host) : packed data helpers (240 + h.val) = helpers h := by
+  have hi : ¬ 240 + h.val < 240 := by omega
+  have hr : 240 + h.val < 987 := by omega
+  simp [packed, hi, hr]
+
+def dataOther {X : Type u} (data : Data → Values X) : Data → Values X :=
+  fun i => if hi : 120 ≤ i.val then
+    fun x => data i x ^^ data ⟨i.val - 120, by omega⟩ x
+  else data i
+
+/-- This actually evaluates the certified literal word, not an assumed
+closed-form endpoint. The clean temporary is included in the tree. -/
+def invoke {X : Type u} (data : Data → Values X) (helpers : Host → Values X) :
+    (Data → Values X) × (Host → Values X) :=
+  let input := packed data helpers
+  let output := runPayloads SourceMatrix.forwardWord
+    (Tree.tabulate 10 (fun i => if i < 987 then input i else fun _ => false))
+  (fun i => output.get i.val, fun h => output.get (240 + h.val))
+
+theorem invoke_endpoint {X : Type u} (data : Data → Values X) (helpers : Host → Values X) :
+    invoke data helpers = (dataOther data, helpers) := by
+  have hwhole := SourceMatrix.arbitrary_dirty_payloads (packed data helpers)
+  have hprojected := congrArg (fun output : Tree (Values X) =>
+    ((fun i : Data => output.get i.val), (fun h : Host => output.get (240 + h.val)))) hwhole
+  apply hprojected.trans
+  apply Prod.ext
+  · funext i
+    change (Tree.tabulate 10 (SourceMatrix.endpointPayload (packed data helpers))).get i.val = _
+    rw [Tree.get_tabulate 10 _ i.val (by omega)]
+    unfold SourceMatrix.endpointPayload
+    have hir : i.val < 987 := by omega
+    by_cases hi : 120 ≤ i.val
+    · have hs : i.val - 120 < 240 := by omega
+      simp [dataOther, hi, hir, i.isLt, packed, hs]
+    · simp [dataOther, hi, hir, i.isLt, packed]
+  · funext h
+    change (Tree.tabulate 10 (SourceMatrix.endpointPayload (packed data helpers))).get (240 + h.val) = _
+    rw [Tree.get_tabulate 10 _ (240 + h.val) (by omega)]
+    have hr : 240 + h.val < 987 := by omega
+    have hn : ¬ 240 + h.val < 240 := by omega
+    simp only [SourceMatrix.endpointPayload, hr, hn, and_false, ↓reduceIte, packed_helper]
+
+def role (h : Host) : SourceOwnership.Role := ⟨240 + h.val, by omega⟩
+def residual (h : Host) : Mask SourceOwnership.Axis :=
+  SourceOwnership.targetMask (SourceOwnership.tag (role h))
+
+/-- Complete paired-address conjugacy, including both entries at every
+coordinate. This is stronger than just matching mask descriptors. -/
+theorem swap_conjugacy {K : Type} (t : SourceOwnership.Tag)
+    (a : Address SourceOwnership.Axis K) :
+    SourceOwnership.reindex t
+      (swapAddress (SourceOwnership.sourceMask t) (SourceOwnership.unindex t a)) =
+      swapAddress (SourceOwnership.targetMask t) a := by
+  funext i
+  have hm := SourceOwnership.perm_support t (SourceOwnership.invPerm t i)
+  rw [SourceOwnership.inverse_perm] at hm
+  simp only [SourceOwnership.reindex, SourceOwnership.unindex, swapAddress,
+    SourceOwnership.inverse_perm, ← hm]
+
+def hostInput {K : Type} (h : Host) (v : Stream SourceOwnership.Axis K Bool) :
+    Stream SourceOwnership.Axis K Bool :=
+  fun a => v (SourceOwnership.reindex (SourceOwnership.tag (role h)) a)
+
+def hostOutput {K : Type} (h : Host) (v : Stream SourceOwnership.Axis K Bool) :
+    Stream SourceOwnership.Axis K Bool :=
+  fun a => v (swapAddress (SourceOwnership.sourceMask (SourceOwnership.tag (role h)))
+    (SourceOwnership.unindex (SourceOwnership.tag (role h)) a))
+
+theorem host_transport {K : Type} (h : Host) (v : Stream SourceOwnership.Axis K Bool) :
+    hostOutput h (hostInput h v) = bitAction (residual h) v := by
+  funext a
+  exact congrArg v (swap_conjugacy (SourceOwnership.tag (role h)) a)
+
+abbrev Streams (K : Type) := Stream SourceOwnership.Axis K Bool
+abbrev Retained (K : Type) (Tail : Type v) := (Data → Streams K) × Tail
+
+/-- Data gather/scatter maps are common to the original and relocated
+layouts. All data outputs and the untouched exterior state are retained. -/
+def event {K : Type} {Tail : Type v}
+    (dataInput dataOutput : Data → Streams K → Streams K) :
+    MultiHosting.WindowEvent Host SourceOwnership.Axis (Retained K Tail) where
+  idle := fun _ _ => false
+  residual := residual
+  other s := (fun i => dataOutput i (dataOther (fun j => dataInput j (s.1 j)) i), s.2)
+
+/-- Old helpers are a separate bank; its actual normalized endpoint and
+chosen physical output charts are returned, not reset between invocations. -/
+def original {K : Type} {Tail : Type v}
+    (dataInput dataOutput : Data → Streams K → Streams K)
+    (oldInput oldOutput : Host → Streams K → Streams K)
+    (s : MultiHosting.WindowState Host SourceOwnership.Axis K Bool (Retained K Tail) ×
+      (Host → Streams K)) :=
+  let result := invoke (fun i => dataInput i (s.1.2.1 i)) (fun h => oldInput h (s.2 h))
+  ((s.1.1, (fun i => dataOutput i (result.1 i), s.1.2.2)),
+    fun h => oldOutput h (result.2 h))
+
+def relocated {K : Type} {Tail : Type v}
+    (dataInput dataOutput : Data → Streams K → Streams K)
+    (s : MultiHosting.WindowState Host SourceOwnership.Axis K Bool (Retained K Tail) × Unit) :=
+  let result := invoke (fun i => dataInput i (s.1.2.1 i)) (fun h => hostInput h (s.1.1 h))
+  ((fun h => hostOutput h (result.2 h), (fun i => dataOutput i (result.1 i), s.1.2.2)), s.2)
+
+theorem original_retained {K : Type} {Tail : Type v}
+    (dataInput dataOutput : Data → Streams K → Streams K)
+    (oldInput oldOutput : Host → Streams K → Streams K)
+    (s : MultiHosting.WindowState Host SourceOwnership.Axis K Bool (Retained K Tail))
+    (bank : Host → Streams K) :
+    (original dataInput dataOutput oldInput oldOutput (s, bank)).1 =
+      (event dataInput dataOutput).base s := by
+  simp only [original, invoke_endpoint, event, MultiHosting.WindowEvent.base]
+  apply Prod.ext
+  · funext h; exact (bitAction_empty (s.1 h)).symm
+  · rfl
+
+theorem original_bank_output {K : Type} {Tail : Type v}
+    (dataInput dataOutput : Data → Streams K → Streams K)
+    (oldInput oldOutput : Host → Streams K → Streams K)
+    (s : MultiHosting.WindowState Host SourceOwnership.Axis K Bool (Retained K Tail))
+    (bank : Host → Streams K) :
+    (original dataInput dataOutput oldInput oldOutput (s, bank)).2 =
+      fun h => oldOutput h (oldInput h (bank h)) := by
+  simp only [original, invoke_endpoint]
+
+theorem relocated_retained {K : Type} {Tail : Type v}
+    (dataInput dataOutput : Data → Streams K → Streams K)
+    (s : MultiHosting.WindowState Host SourceOwnership.Axis K Bool (Retained K Tail))
+    (bank : Unit) :
+    (relocated dataInput dataOutput (s, bank)).1 = (event dataInput dataOutput).hosted s := by
+  simp only [relocated, invoke_endpoint, event, MultiHosting.WindowEvent.hosted,
+    MultiHosting.WindowEvent.base, MultiHosting.onHosts]
+  apply Prod.ext
+  · funext h
+    change hostOutput h (hostInput h (s.1 h)) =
+      bitAction (residual h) (bitAction (fun _ => false) (s.1 h))
+    rw [host_transport, bitAction_empty]
+  · rfl
+
+/-- A contract for the literal normalized word with the displayed coordinate
+adapters. It is a physical source contract only after those adapters and the
+987 distinct role owners are identified with the actual source execution. -/
+def normalizedContract {K : Type} {Tail : Type v}
+    (dataInput dataOutput : Data → Streams K → Streams K)
+    (oldInput oldOutput : Host → Streams K → Streams K) :
+    MultiHosting.PhysicalContract (K := K) (A := Bool) (event (Tail := Tail) dataInput dataOutput)
+      (Host → Streams K) Unit where
+  original := original dataInput dataOutput oldInput oldOutput
+  relocated := relocated dataInput dataOutput
+  original_retained := original_retained dataInput dataOutput oldInput oldOutput
+  relocated_retained := relocated_retained dataInput dataOutput
+
+end SourceConnection
diff --git a/research/lean-multi-host-source/SourceControls.lean b/research/lean-multi-host-source/SourceControls.lean
new file mode 100644
index 0000000..0705367
--- /dev/null
+++ b/research/lean-multi-host-source/SourceControls.lean
@@ -0,0 +1,58 @@
+import MatrixCertificate
+set_option maxRecDepth 100000
+set_option maxHeartbeats 0
+
+/-!
+Focused source controls. These retain the distinction between arbitrary
+original inputs and the required clean private register. The mutation is an
+intentional alteration of one actual instruction, not a claim about the
+submitted program.
+-/
+namespace SourceControls
+open LinearReplay (Event)
+open TreeReplay SourceMatrix
+
+/-- Event 218 of the actual word, at offset 18 in its second chunk. -/
+theorem actual_add_event : chunk1[18]? = some (⟨1,126,243,true⟩ : Event) := by rfl
+
+def omittedAdd : List Event := chunk1.set 18 ⟨1,126,243,false⟩
+
+/-- Omitting this source XOR loses exactly original variable 243 from row126. -/
+theorem omitted_add_changes_row :
+    (runCheckedRows omittedAdd state1).1.get 126 ^^^ state2.1.get 126 =
+      1 <<< 243 := by rfl
+
+/-- The missing XOR is not detected merely by clean-work checks. -/
+theorem omitted_add_keeps_guards :
+    (runCheckedRows omittedAdd state1).2 = true := by rfl
+
+/-- Event13558 is the first actual COPY, into private role987. -/
+theorem actual_first_copy : chunk67[158]? = some (⟨2,0,987,true⟩ : Event) := by rfl
+
+def firstCopy : Event := ⟨2,0,987,true⟩
+def dirtyPrivate : Tree Nat := initial.put 987 (1 <<< 243)
+
+theorem dirty_private_copy_rejected : rowChecks dirtyPrivate firstCopy = false := by rfl
+
+theorem dirty_private_copy_would_overwrite :
+    (rowStep dirtyPrivate firstCopy).get 987 = 1 := by rfl
+
+/-- This is a result of the actual complete word, using its checked certificate. -/
+theorem literal_helper_three_survives :
+    (runRows forwardWord initial).get 243 = 1 <<< 243 := by
+  rw [literal_word_rows]
+  rfl
+
+/-- The complete word cannot have the often-mistaken all-zero helper endpoint. -/
+theorem literal_helper_three_not_zero :
+    (runRows forwardWord initial).get 243 ≠ 0 := by
+  rw [literal_helper_three_survives]
+  decide
+
+#print axioms omitted_add_changes_row
+#print axioms omitted_add_keeps_guards
+#print axioms dirty_private_copy_rejected
+#print axioms dirty_private_copy_would_overwrite
+#print axioms literal_helper_three_survives
+#print axioms literal_helper_three_not_zero
+end SourceControls
diff --git a/research/lean-multi-host-source/SourceDataBehavior.lean b/research/lean-multi-host-source/SourceDataBehavior.lean
new file mode 100644
index 0000000..c0acdf4
--- /dev/null
+++ b/research/lean-multi-host-source/SourceDataBehavior.lean
@@ -0,0 +1,130 @@
+import SourceInvocationComparison
+
+/-!
+The data operation of the selected call, with its actual unequal entrance
+and exit frames displayed. The scalar certificate adds source i to target
+120+i. Physical streams additionally undergo the stated frame and port-chart
+pullbacks; this file does not identify those pullbacks with identity maps.
+All data and helper payloads are arbitrary Boolean functions.
+Apache-2.0. Prepared with substantial OpenAI Codex assistance.
+-/
+namespace SourceDataBehavior
+open SourceConnection FramedReplay
+set_option maxRecDepth 100000
+set_option maxHeartbeats 0
+attribute [local irreducible] SourceFramed.final SourceRaw.final
+
+def first (i : Fin 120) : Data := ⟨i.val, by omega⟩
+def second (i : Fin 120) : Data := ⟨120 + i.val, by omega⟩
+
+theorem first_initial_frame : ∀ i : Fin 120,
+    SourceFrameTrace.state0.frames.get (first i).val = i.val + 2 := by decide
+theorem second_initial_frame : ∀ i : Fin 120,
+    SourceFrameTrace.state0.frames.get (second i).val = 0 := by decide
+theorem first_final_frame : ∀ i : Fin 120,
+    SourceFrameTrace.state96.frames.get (first i).val = 1 := by decide
+theorem second_final_frame : ∀ i : Fin 120,
+    SourceFrameTrace.state96.frames.get (second i).val = i.val + 824 := by decide
+
+theorem framed_first {K : Type} (gauges : PhysicalSourceConnection.Gauges K)
+    (data : Data → Streams K) (helpers : Host → Streams K) (i : Fin 120) :
+    PhysicalSourceConnection.physicalData gauges data helpers (first i) =
+      fun a => data (first i)
+        ((gauges (i.val + 2)).forward ((gauges 1).inverse a)) := by
+  have he := congrFun
+    (PhysicalSourceConnection.physical_data_endpoints gauges data helpers) (first i)
+  apply he.trans
+  funext a
+  have hi : (first i).val < 987 := by simp only [first]; omega
+  have hn : ¬ 120 ≤ (first i).val := by simp only [first]; omega
+  simp only [SourceMatrix.endpointPayload, hi, hn, false_and, ↓reduceIte,
+    SourceFramed.normalizedInput, packed_data, first_initial_frame, first_final_frame]
+
+theorem framed_second {K : Type} (gauges : PhysicalSourceConnection.Gauges K)
+    (data : Data → Streams K) (helpers : Host → Streams K) (i : Fin 120) :
+    PhysicalSourceConnection.physicalData gauges data helpers (second i) =
+      fun a => data (second i)
+        ((gauges 0).forward ((gauges (i.val + 824)).inverse a)) ^^
+        data (first i)
+          ((gauges (i.val + 2)).forward ((gauges (i.val + 824)).inverse a)) := by
+  have he := congrFun
+    (PhysicalSourceConnection.physical_data_endpoints gauges data helpers) (second i)
+  apply he.trans
+  funext a
+  have hi : (second i).val < 987 := by simp only [second]; omega
+  have ht : 120 ≤ (second i).val ∧ (second i).val < 240 := by simp only [second]; omega
+  have hs : (second i).val - 120 = (first i).val := by simp only [first, second]; omega
+  simp only [SourceMatrix.endpointPayload, hi, ht, and_self, ↓reduceIte, hs,
+    SourceFramed.normalizedInput, packed_data, first_initial_frame,
+    second_initial_frame, second_final_frame]
+
+/-- Complete output data function, in the actual owner-coordinate chart. -/
+def dataFormula (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+    (gauges : SourceInvocation.Gauges K) (data : Data → Streams K) (i : Data) : Streams K :=
+  SourceInvocation.dataOutput K h2 i
+    (fun a => if ht : 120 ≤ i.val then
+      SourceInvocation.dataInput K h2 i (data i)
+        ((gauges 0).forward ((gauges (i.val - 120 + 824)).inverse a)) ^^
+      SourceInvocation.dataInput K h2 ⟨i.val - 120, by omega⟩ (data ⟨i.val - 120, by omega⟩)
+        ((gauges (i.val - 120 + 2)).forward
+          ((gauges (i.val - 120 + 824)).inverse a))
+    else SourceInvocation.dataInput K h2 i (data i)
+      ((gauges (i.val + 2)).forward ((gauges 1).inverse a)))
+
+theorem framed_data_formula (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+    (gauges : SourceInvocation.Gauges K) (data : Data → Streams K)
+    (helpers : Host → Streams K) (i : Data) :
+    SourceInvocation.dataOutput K h2 i
+      (PhysicalSourceConnection.physicalData gauges
+        (fun j => SourceInvocation.dataInput K h2 j (data j)) helpers i) =
+      dataFormula K h2 gauges data i := by
+  by_cases ht : 120 ≤ i.val
+  · let j : Fin 120 := ⟨i.val - 120, by omega⟩
+    have hj : second j = i := by apply Fin.ext; simp only [second, j]; omega
+    rw [← hj, framed_second]
+    unfold dataFormula
+    have hjt : 120 ≤ (second j).val := by simp only [second]; omega
+    simp only [dif_pos hjt]
+    simp only [second, Nat.add_sub_cancel_left]
+    rfl
+  · let j : Fin 120 := ⟨i.val, by omega⟩
+    have hj : first j = i := rfl
+    rw [← hj, framed_first]
+    unfold dataFormula
+    have hjt : ¬ 120 ≤ (first j).val := ht
+    simp only [hjt, ↓reduceDIte]
+    rfl
+
+/-- The actual old-bank invocation has this exact data endpoint, for every
+independent dirty bank input. -/
+theorem old_data_formula (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+    (d : SourceOwnership.Vec K ≃ SourceOwnership.Vec K)
+    (gauges : SourceInvocation.Gauges K) (s : SourceInvocation.State K h2 d)
+    (bank : Host → Streams K) (i : Data) :
+    (SourceInvocation.oldRaw K h2 d gauges s bank
+      (SourceInvocation.oldOwner K h2 d (SourceLayouts.dataRole i))).2 =
+      dataFormula K h2 gauges s.2.1 i :=
+  (SourceInvocation.oldRaw_data K h2 d gauges s bank i).trans
+    (framed_data_formula K h2 gauges s.2.1 _ i)
+
+/-- The actual hosted invocation has the identical formula for all data,
+despite every retained host carrying an arbitrary dirty stream. -/
+theorem new_data_formula (K : Type) [Field K] (h2 : (2 : K) ≠ 0)
+    (d : SourceOwnership.Vec K ≃ SourceOwnership.Vec K)
+    (gauges : SourceInvocation.Gauges K) (s : SourceInvocation.State K h2 d) (i : Data) :
+    (SourceInvocation.newRaw K h2 d gauges s
+      (SourceInvocation.newOwner K h2 d (SourceLayouts.dataRole i))).2 =
+      dataFormula K h2 gauges s.2.1 i :=
+  (SourceInvocation.newRaw_data K h2 d gauges s i).trans
+    (framed_data_formula K h2 gauges s.2.1 _ i)
+
+#print axioms first_initial_frame
+#print axioms second_initial_frame
+#print axioms first_final_frame
+#print axioms second_final_frame
+#print axioms framed_first
+#print axioms framed_second
+#print axioms framed_data_formula
+#print axioms old_data_formula
+#print axioms new_data_formula
+end SourceDataBehavior
diff --git a/research/lean-multi-host-source/SourceEndpoint.lean b/research/lean-multi-host-source/SourceEndpoint.lean
