abbrev Role := Fin 987
abbrev Tag := Fin 16
abbrev Axis := Fin 64

def family (r : Role) : Nat := lookup familyTable r.val
def tag (r : Role) : Tag := ⟨lookup tagTable r.val % 16, Nat.mod_lt _ (by decide)⟩
def perm (t : Tag) (i : Axis) : Axis :=
  ⟨lookup permTable (64 * t.val + i.val) % 64, Nat.mod_lt _ (by decide)⟩
def invPerm (t : Tag) (i : Axis) : Axis :=
  ⟨lookup invPermTable (64 * t.val + i.val) % 64, Nat.mod_lt _ (by decide)⟩
def sourceMask (t : Tag) (i : Axis) : Bool := (lookup sourceBits t.val).testBit i.val
def targetMask (t : Tag) (i : Axis) : Bool := (lookup targetBits t.val).testBit i.val

theorem perm_inverse : ∀ (t : Tag) (i : Axis), invPerm t (perm t i) = i := by decide
theorem inverse_perm : ∀ (t : Tag) (i : Axis), perm t (invPerm t i) = i := by decide
theorem perm_support : ∀ (t : Tag) (i : Axis), targetMask t (perm t i) = sourceMask t i := by decide

def fingerprint (t : Tag) : Nat :=
  (List.range 8).foldl (fun n i => n + (perm t ⟨i % 64, Nat.mod_lt _ (by decide)⟩).val * 64^i) 0

theorem fingerprint_injective : ∀ (a b : Tag), fingerprint a = fingerprint b → a = b := by decide

theorem owner_inverse : ∀ r : Role, lookup inverseOwnerTable (16 * family r + (tag r).val) = r.val := by decide

theorem family_tag_injective {r s : Role} (hf : family r = family s) (ht : tag r = tag s) : r = s := by
  apply Fin.ext
  rw [← owner_inverse r, ← owner_inverse s, hf, ht]

theorem family_data : ∀ r : Fin 240, family ⟨r.val, Nat.lt_trans r.isLt (by decide)⟩ = r.val := by decide

theorem helper_range : ∀ r : Role, 240 ≤ r.val → 240 ≤ family r ∧ family r < 720 := by decide

theorem helper_frame : ∀ r : Role, 240 ≤ r.val → lookup initialFrameTable r.val = lookup tagInitialFrame (tag r).val := by decide

theorem helper_child : ∀ r : Role, 240 ≤ r.val → ((tag r).val ≥ 7 ↔ family r ≥ 480) := by decide

end SourceOwnership
